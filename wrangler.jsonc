{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mark1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "689810a4-76fe-4b35-a43a-760a7b0b925a","database_name": "mark1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a296fa6dcbc042e4b198b99e6276ab9b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
